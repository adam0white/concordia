{
	"name": "alder-quay-neighbours",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "node scripts/prepare-runtime.mjs && tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p e2e/tsconfig.json",
		"test": "vitest run tests",
		"lint": "biome check --error-on-warnings src tests scripts e2e *.ts *.json",
		"check": "npm run lint && npm run typecheck && npm test && npm run build",
		"test:parity": "node scripts/check-parity.mjs",
		"build:cloudflare": "node scripts/prepare-runtime.mjs && tsc --noEmit && CF_BUILD=1 cf build",
		"deploy": "cf deploy --prebuilt --mode production",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@adam0white/human-framework": "2.2.1",
		"pyodide": "314.0.7",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cloudflare/vite-plugin": "2.0.0-beta.v.0",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"cf": "1.0.0-beta.16",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
