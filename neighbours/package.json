{
	"name": "alder-quay-neighbours",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "26.12.0"
	},
	"overrides": {
		"@cloudflare/config": {
			"zod": "4.6.7"
		},
		"miniflare": {
			"undici": "7.30.1"
		}
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "node scripts/prepare-runtime.mjs && tsc --noEmit && vite build && node scripts/check-release.mjs dist/release.json",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p e2e/tsconfig.json",
		"test": "vitest run tests --maxWorkers=1",
		"lint": "biome check --error-on-warnings src tests scripts e2e *.ts *.json",
		"check": "npm run lint && npm run typecheck && npm test && npm run test:node-imports && npm run build",
		"test:parity": "node scripts/check-parity.mjs",
		"build:cloudflare": "node scripts/prepare-runtime.mjs && tsc --noEmit && CF_BUILD=1 cf build && node scripts/check-release.mjs .cloudflare/output/v0/workers/default/assets/release.json",
		"deploy": "node scripts/check-release.mjs .cloudflare/output/v0/workers/default/assets/release.json --clean && cf deploy --prebuilt --mode production",
		"test:e2e": "playwright test",
		"test:node-imports": "node scripts/check-node-imports.mjs",
		"check:lane": "npm run check"
	},
	"dependencies": {
		"@adam0white/human-framework": "4.17.0",
		"@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.5.15.tgz",
		"@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.32.tgz",
		"@noble/hashes": "2.4.0",
		"pyodide": "314.0.7",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"@cloudflare/vite-plugin": "2.0.0-beta.v.4",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"cf": "1.0.0-beta.21",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	},
	"packageManager": "pnpm@12.16.1"
}
