{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["src", "tests", "vite.config.ts"]
}
